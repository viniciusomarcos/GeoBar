# PostgreSQL + PostGIS connection (local Docker)
DATABASE_URL=postgresql://geobar:geobar@localhost:5432/geobar

# Optional local Docker container credentials (docker-compose.yml)
POSTGRES_USER=geobar
POSTGRES_PASSWORD=geobar
POSTGRES_DB=geobar

# Example production connection through the Supabase pooler (SSL required):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
