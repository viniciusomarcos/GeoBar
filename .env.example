# Conexão PostgreSQL + PostGIS (Docker local)
DATABASE_URL=postgresql://geobar:geobar@localhost:5432/geobar

# Credenciais opcionais do container Docker local (docker-compose.yml)
POSTGRES_USER=geobar
POSTGRES_PASSWORD=geobar
POSTGRES_DB=geobar

