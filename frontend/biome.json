{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": true,
    "root": "..",
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/dist",
      "!**/coverage",
      "!cypress/screenshots",
      "!cypress/videos",
      "!cypress/results",
      "!**/.media-work",
      "!public/media",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useBlockStatements": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "generic"
          }
        }
      },
      "complexity": {
        "useArrowFunction": "error"
      },
      "correctness": {
        "noRestrictedElements": {
          "level": "error",
          "options": {
            "elements": {
              "a": "Use Pressable for links.",
              "button": "Use Pressable for actions.",
              "Link": "Use Pressable for navigation.",
              "p": "Use Text for typography.",
              "span": "Use Text for inline content.",
              "strong": "Use Text with as=strong.",
              "small": "Use Text with as=small.",
              "em": "Use Text with as=em.",
              "b": "Use Text with as=b.",
              "i": "Use Text with as=i.",
              "h1": "Use Text with as=h1.",
              "h2": "Use Text with as=h2.",
              "h3": "Use Text with as=h3.",
              "h4": "Use Text with as=h4.",
              "h5": "Use Text with as=h5.",
              "h6": "Use Text with as=h6.",
              "figcaption": "Use Text with as=figcaption.",
              "label": "Use Text with as=label.",
              "legend": "Use Text with as=legend.",
              "code": "Use Text with as=code."
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "none",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/Pressable/**",
        "src/components/Text/**",
        "src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": "off"
          }
        }
      }
    }
  ]
}
