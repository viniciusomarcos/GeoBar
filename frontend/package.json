{
  "name": "geobar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next dev --webpack",
    "start:prod": "next start",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test \"next start --hostname 127.0.0.1 --port 4173\" http://127.0.0.1:4173/en \"cypress run\"",
    "test:e2e:ui": "start-server-and-test \"next dev --webpack --hostname 127.0.0.1 --port 4173\" http://127.0.0.1:4173/en \"cypress open\""
  },
  "dependencies": {
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "cypress": "16.3.0",
    "jsdom": "31.0.1",
    "start-server-and-test": "3.0.13",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
